<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    
    <!-- 包信息 -->
    <PackageId>SpeedHub.Cli</PackageId>
    <Description>SpeedHub - 命令行接口</Description>
    <Copyright>Copyright (c) 2026 Vogadero</Copyright>
    <Authors>Vogadero</Authors>
    <Version>3.0.0-alpha.1</Version>

    <!-- 应用图标 -->
    <ApplicationIcon>..\..\assets\app-icon.ico</ApplicationIcon>

    <!-- 单文件发布 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- 项目引用 -->
  <ItemGroup>
    <ProjectReference Include="..\SpeedHub.Core\SpeedHub.Core.csproj" />
    <ProjectReference Include="..\SpeedHub.Web\SpeedHub.Web.csproj" />
  </ItemGroup>

  <!-- NuGet 依赖 -->
  <ItemGroup>
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="8.0.0" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
  </ItemGroup>

  <!-- 确保配置文件被复制到发布目录 -->
  <!-- 注意: wwwroot 静态文件不需要手动链接，SpeedHub.Web 的 ProjectReference 会自动带入 -->
  <ItemGroup>
    <Content Include="..\appsettings.json" CopyToPublishDirectory="PreserveNewest" Link="appsettings.json" />
    <Content Include="..\appsettings\*.json" CopyToPublishDirectory="PreserveNewest" LinkBase="appsettings" />
  </ItemGroup>

</Project>
