<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    
    <!-- 包信息 -->
    <PackageId>SpeedHub.Web</PackageId>
    <Description>SpeedHub - 新一代开发者网络加速器 Web Dashboard</Description>
    <Copyright>Copyright (c) 2026 Vogadero</Copyright>
    <Authors>Vogadero</Authors>
    <Version>3.0.0-alpha.1</Version>
    
    <!-- 输出设置 -->
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <!-- 项目引用 -->
  <ItemGroup>
    <ProjectReference Include="..\SpeedHub.Core\SpeedHub.Core.csproj" />
  </ItemGroup>

  <!-- NuGet 依赖 -->
  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" Version="2.2.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
  </ItemGroup>

</Project>
