{
  "SpeedHub": {
    "HttpProxyPort": 38457,
    "HttpsProxyPort": 443,
    "HttpPort": 80,
    "SshProxyPort": 22,
    "GitProtocolPort": 9418,
    "FallbackDns": [
      "8.8.8.8:53",
      "8.8.4.4:53",
      "1.1.1.1:53",
      "1.0.0.1:53",
      "9.9.9.9:53",
      "149.112.112.112:53",
      "119.29.29.29:53",
      "182.254.116.116:53",
      "114.114.114.114:53",
      "114.114.115.115:53",
      "223.5.5.5:53",
      "223.6.6.6:53"
    ],
    "DnsCacheTtlMinutes": 5,
    "DnsQueryTimeoutMs": 3000,
    "MaxConnectionsPerServer": 20,
    "ConnectionPoolLifetimeMinutes": 5,
    "ConnectionPoolIdleTimeoutMinutes": 2,
    "EnableIpSpeedTest": true,
    "LogLevel": "Information",
    "DomainConfigs": {
      "*.speedhub.com": {
        "TlsSni": false
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Yarp": "Warning",
        "System": "Warning",
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Server.Kestrel": "Error"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "WebDashboard": {
        "Url": "http://localhost:38458"
      },
      "HttpProxy": {
        "Url": "http://*:38457"
      }
    }
  }
}
